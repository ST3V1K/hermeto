{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "schedule:monthly"
  ],
  // Override :ignoreModulesAndTests so test Containerfiles are scanned
  // (https://github.com/hermetoproject/hermeto/issues/1681).
  "ignorePaths": [
    "**/node_modules/**",
    "**/bower_components/**",
    "**/vendor/**",
    "**/examples/**",
    "**/__tests__/**",
    "**/test/**",
    "**/__fixtures__/**"
  ],
  "enabledManagers": [
    "dockerfile",
    "github-actions",
    "pip-compile"
  ],
  "pep621": {
    "enabled": false
  },
  "pip_requirements": {
    "enabled": false
  },
  // Match compiled outputs; Renovate reads the uv pip compile command from the header.
  // https://docs.renovatebot.com/modules/manager/pip-compile/
  "pip-compile": {
    "managerFilePatterns": [
      "/^requirements\\.txt$/",
      "/^requirements-extras\\.txt$/",
      "/^requirements-build\\.txt$/"
    ]
  },
  "packageRules": [
    {
      "description": "Weekly GitHub Actions updates",
      "matchManagers": [
        "github-actions"
      ],
      "extends": [
        "schedule:weekly"
      ]
    },
    {
      "description": "Dockerfile commit message prefix",
      "matchManagers": [
        "dockerfile"
      ],
      "commitMessagePrefix": "Dockerfile"
    },
    // Go: handle major.minor releases manually due to direct feature support
    // Rust: handle major.minor releases manually since they might break tests
    {
      "description": "Disable golang and rust major and minor updates in production Dockerfile",
      "matchFileNames": [
        "Dockerfile"
      ],
      "matchPackageNames": [
        "**/golang",
        "**/rust"
      ],
      "matchUpdateTypes": [
        "major",
        "minor"
      ],
      "enabled": false
    },
    // Node v25 stopped shipping corepack which we need
    {
      "description": "Limit node to versions below 25 in production Dockerfile",
      "matchFileNames": [
        "Dockerfile"
      ],
      "matchPackageNames": [
        "**/node"
      ],
      "allowedVersions": "<25"
    },
    {
      "description": "Ignore pydantic-core",
      "matchManagers": [
        "pip-compile"
      ],
      "matchPackageNames": [
        "pydantic-core"
      ],
      "enabled": false
    },
    {
      "description": "Limit createrepo-c to versions below 1.2.2",
      "matchManagers": [
        "pip-compile"
      ],
      "matchPackageNames": [
        "createrepo-c"
      ],
      "allowedVersions": "<1.2.2"
    },
    {
      "description": "Group Python minor and patch updates",
      "matchManagers": [
        "pip-compile"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "groupName": "minor-and-patch"
    },
    // Test Containerfiles (https://github.com/hermetoproject/hermeto/issues/1681):
    // patch-only on pinned images; all test image bumps share one PR.
    {
      "description": "Disable major and minor updates in test Containerfiles",
      "matchManagers": [
        "dockerfile"
      ],
      "matchFileNames": [
        "tests/**"
      ],
      "matchUpdateTypes": [
        "major",
        "minor"
      ],
      "enabled": false
    },
    {
      "description": "Group all test Containerfile updates",
      "matchManagers": [
        "dockerfile"
      ],
      "matchFileNames": [
        "tests/**"
      ],
      "groupName": "test Containerfiles"
    }
  ]
}
